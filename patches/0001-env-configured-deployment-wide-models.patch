@@ -0,0 +1,79 @@
+import { AiChatAuthorInfo, AiModelConfig, AiModelProvider, SUGGESTED_MODELS } from "@gadgets/workshop-shared/api";
+import type { UserAiModelRecord } from "./storage-schema/user-storage.js";
+
+// Deployment-wide AI models configured via provider API keys in env, for self-hosted
+// deployments (e.g. the Docker image): set ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY
+// and every user gets that provider's SUGGESTED_MODELS without entering a key in the UI.
+//
+// This mirrors the AI Gateway pattern (ai-gateway.ts): env models are merged into listModels()
+// ahead of user-configured models and resolved in getChatContext() the same way. Unlike gateway
+// mode, the API key is placed directly in the returned AiModelConfig, which flows through the
+// same (private) code paths as a key the user typed into the UI.
+//
+// When AI Gateway mode is active it takes priority; env models whose provider the gateway
+// already offers are skipped so the model list contains no duplicates.
+
+const PROVIDER_ENV_KEYS: [AiModelProvider, (env: Cloudflare.Env) => string | undefined][] = [
+  ["anthropic", env => env.ANTHROPIC_API_KEY],
+  ["openai", env => env.OPENAI_API_KEY],
+  ["google", env => env.GOOGLE_API_KEY],
+];
+
+export class EnvModelsConfig {
+  // Providers with a deployment-wide key, in PROVIDER_ENV_KEYS order.
+  readonly providerKeys: Map<AiModelProvider, string>;
+
+  constructor(env: Cloudflare.Env) {
+    this.providerKeys = new Map();
+    for (const [provider, getKey] of PROVIDER_ENV_KEYS) {
+      const key = getKey(env);
+      if (key) this.providerKeys.set(provider, key);
+    }
+  }
+
+  /**
+   * Get the list of env-configured models, as AiChatAuthorInfo entries.
+   */
+  getModelList(): AiChatAuthorInfo[] {
+    let result: AiChatAuthorInfo[] = [];
+    for (let [provider, models] of Object.entries(SUGGESTED_MODELS)) {
+      if (this.providerKeys.has(provider as AiModelProvider)) {
+        for (let [id, model] of Object.entries(models)) {
+          result.push({ type: "agent", id, name: model.name });
+        }
+      }
+    }
+    return result;
+  }
+
+  /**
+   * Look up an env-configured model by ID. Returns a UserAiModelRecord (with the deployment-wide
+   * API key as its apiToken) if the model is a SUGGESTED_MODEL for a provider with a key in env,
+   * or undefined otherwise.
+   */
+  resolveModel(modelId: string): UserAiModelRecord | undefined {
+    for (let [provider, models] of Object.entries(SUGGESTED_MODELS)) {
+      let apiToken = this.providerKeys.get(provider as AiModelProvider);
+      if (apiToken !== undefined && Object.hasOwn(models, modelId)) {
+        return {
+          profile: { type: "agent", id: modelId, name: models[modelId].name },
+          config: {
+            provider: provider as AiModelConfig["provider"],
+            model: modelId,
+            apiToken,
+          },
+        };
+      }
+    }
+    return undefined;
+  }
+}
+
+/**
+ * Parse env-configured deployment-wide models from environment variables. Returns null if no
+ * provider API keys are set.
+ */
+export function getEnvModelsConfig(env: Cloudflare.Env): EnvModelsConfig | null {
+  const config = new EnvModelsConfig(env);
+  return config.providerKeys.size > 0 ? config : null;
+}
