+  // Each gatekeeper builds its own OAuth redirect_uri from env.BASE_URL, falling back to
+  // `http://localhost:8787/gatekeeper/<name>` when unset. That default is right for local dev
+  // and wrong behind a reverse proxy or custom domain: the consent screen appears, then the
+  // callback goes to the user's own machine instead of the deployment.
+  //
+  // The deploy path already solves this — scripts/release/manifest-lib.mjs sets
+  // `BASE_URL = $PUBLIC_BASE_URL/gatekeeper/<shortName>` per gatekeeper — but nothing seeds it
+  // here, so a self-hosted instance running this dev server has no way to set it. Mirror that
+  // same derivation, keeping the two paths in agreement.
+  //
+  // Only when PUBLIC_BASE_URL is set: unset means local dev, where the fallback is correct.
+  // A value already in wrangler.jsonc wins, matching how CLIENT_ID/CLIENT_SECRET behave above.
+  if (process.env.PUBLIC_BASE_URL) {
+    const origin = process.env.PUBLIC_BASE_URL.replace(/\/+$/, "");
+    // "gatekeeper-google" -> "google", the same path segment the router derives from the
+    // GATEKEEPER_* binding name (packages/router/src/index.ts).
+    const shortName = gk.name.slice("gatekeeper-".length);
+    config.vars = config.vars || {};
+    if (config.vars.BASE_URL === undefined) {
+      config.vars.BASE_URL = `${origin}/gatekeeper/${shortName}`;
+    }
+  }
+
   // The shell wins over the committed default, so `MCP_ALLOW_INSECURE=true` can override the
